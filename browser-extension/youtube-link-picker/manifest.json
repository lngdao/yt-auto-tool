{
  "manifest_version": 3,
  "name": "YouTube Batch Link Picker",
  "version": "1.4.0",
  "description": "Select videos on YouTube channel pages, mark previously picked videos, and copy links or titles.",
  "permissions": ["clipboardWrite", "storage"],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
